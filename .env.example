# Application environment: development, testing or production
APP_NAME="Neumonia Platform"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=false
ENABLE_DOCS=true
LOG_LEVEL="INFO"

# Comma-separated values or a JSON list. Never use * in production.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# SQL Server
DB_SERVER="localhost"
DB_PORT="1433"
DB_NAME="nombre_base_datos"
DB_USER="usuario_sql"
DB_PASSWORD="password_seguro"
DB_DRIVER="ODBC Driver 18 for SQL Server"

# JWT. Use at least 32 random characters in production.
SECRET_KEY="cambia-este-valor-por-una-clave-segura"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Radiographs and CNN model
CNN_MODEL_PATH="app/modules/radiographs/densenet121_clahe_finetuned_model.keras"
RADIOGRAPH_UPLOAD_DIR="app/uploads/radiographs"
RADIOGRAPH_MAX_SIZE_MB=10
CNN_MIN_CONFIDENCE=0.60
